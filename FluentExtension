-- ── 4. КОНТЕКСТНОЕ МЕНЮ ПКМ НА ЛЮБОМ ЭЛЕМЕНТЕ FLUENT ────────────────────────

function FluentExtension:AttachContextMenu(fluentElement, optionId, luaPathStr)
    local frame = fluentElement.Frame or fluentElement
    if not frame then return end

    -- Если бинд ещё не инициализирован для этого элемента — создаем структуру
    if not self.Hotkeys[optionId] then
        self.Hotkeys[optionId] = {
            Key = "None",
            Mode = "Toggle",
            Visible = true,
            TargetValue = true,
            Active = false,
            LuaPath = luaPathStr or string.format('ui.find("%s")', optionId)
        }
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            self:OpenContextMenu(input.Position, optionId, fluentElement)
        end
    end)
end

function FluentExtension:OpenContextMenu(position, optionId, fluentElement)
    if self.CurrentContextMenu then self.CurrentContextMenu:Destroy() end

    local bindData = self.Hotkeys[optionId]
    local option = self.Library.Options[optionId]

    local menu = Instance.new("Frame", self.OverlayGui)
    menu.Name = "Fluent_RMB_ContextMenu"
    menu.Size = UDim2.fromOffset(165, 120)
    menu.Position = UDim2.fromOffset(position.X, position.Y)
    menu.BackgroundColor3 = Color3.fromRGB(18, 21, 28)
    menu.BorderSizePixel = 0
    menu.ZIndex = 4000

    Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", menu)
    stroke.Color = Color3.fromRGB(50, 58, 75)

    local layout = Instance.new("UIListLayout", menu)
    layout.Padding = UDim.new(0, 2)
    local pad = Instance.new("UIPadding", menu)
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)

    local function addRow(icon, text, color, callback)
        local btn = Instance.new("TextButton", menu)
        btn.Size = UDim2.new(1, 0, 0, 22)
        btn.BackgroundTransparency = 1
        btn.Text = string.format(" %s  %s", icon, text)
        btn.TextColor3 = color or Color3.fromRGB(225, 230, 245)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.ZIndex = 4001
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseEnter:Connect(function()
            btn.BackgroundTransparency = 0.8
            btn.BackgroundColor3 = Color3.fromRGB(89, 140, 250)
        end)
        btn.MouseLeave:Connect(function() btn.BackgroundTransparency = 1 end)
        btn.MouseButton1Click:Connect(function()
            menu:Destroy()
            self.CurrentContextMenu = nil
            if callback then callback() end
        end)
    end

    local bindText = (bindData and bindData.Key and bindData.Key ~= "None") and string.format("[%s] >", bindData.Key) or "Unbound >"

    addRow("⌨", bindText, Color3.fromRGB(255, 255, 255), function()
        self:OpenHotkeyConfigModal(position, optionId, fluentElement)
    end)

    addRow("📋", "All Hotkeys", Color3.fromRGB(210, 215, 230), function()
        self:OpenAllHotkeysWindow()
    end)

    addRow("➕", "New Hotkey", Color3.fromRGB(210, 215, 230), function()
        self:OpenHotkeyConfigModal(position, optionId, fluentElement)
    end)

    addRow("🔗", "Copy Path", Color3.fromRGB(210, 215, 230), function()
        local path = bindData and bindData.LuaPath or string.format('ui.find("%s")', optionId)
        pcall(function() setclipboard(path) end)
        self.Library:Notify({ Title = "Context Menu", Content = "Скопировано: " .. path, Duration = 2.5 })
    end)

    addRow("🔄", "Reset", Color3.fromRGB(255, 90, 90), function()
        if bindData then
            bindData.Key = "None"
            bindData.Active = false
        end
        if option and option.SetValue then
            option:SetValue(option.Default or false)
        end
        self.Library:Notify({ Title = "Context Menu", Content = "Сброшено к дефолту", Duration = 2 })
    end)

    self.CurrentContextMenu = menu

    -- Закрытие при клике мимо
    local conn
    conn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if menu and menu.Parent then
                local mPos = UserInputService:GetMouseLocation()
                local aPos, aSize = menu.AbsolutePosition, menu.AbsoluteSize
                if mPos.X < aPos.X or mPos.X > aPos.X + aSize.X or mPos.Y < aPos.Y or mPos.Y > aPos.Y + aSize.Y then
                    menu:Destroy()
                    self.CurrentContextMenu = nil
                    conn:Disconnect()
                end
            else
                conn:Disconnect()
            end
        end
    end)
end

-- ── 5. ПОДМЕНЮ НАСТРОЙКИ БИНДА (HOTKEY CONFIG MODAL) ──────────────────────

