-- ── РАСШИРЕНИЕ ОБЪЕКТОВ FLUENT ──────────────────────────────────────────────

function FluentExtension:HookFluentElements()
    local Library = self.Library
    if not Library then return end

    -- Добавляем метод AddTagGrid в секции Fluent
    local origAddSection = Library.Elements.AddSection
    
    -- Внедрение кастомных генераторов виджетов в профиль Fluent
    Library.AddTagGrid = function(container, config)
        return FluentExtension:CreateTagGrid(container, config)
    end
end

return FluentExtension
