    menu.ZIndex = 3000
    self:CreateRound(menu); self:CreateStroke(menu)

    local pad = Instance.new("UIPadding", menu)
    pad.PaddingTop=UDim.new(0,8); pad.PaddingBottom=UDim.new(0,8); pad.PaddingLeft=UDim.new(0,8); pad.PaddingRight=UDim.new(0,8)
    local layout = Instance.new("UIListLayout", menu)
    layout.Padding = UDim.new(0, 8); layout.SortOrder = Enum.SortOrder.LayoutOrder

    local totalHeight = 16

    for _, cfg in ipairs(subConfig) do
        if cfg.Type == "Slider" then
            local r = Instance.new("Frame", menu); r.Size=UDim2.new(1,0,0,36); r.BackgroundTransparency=1
            local t = Instance.new("TextLabel", r); t.Size=UDim2.new(1,0,0,14); t.BackgroundTransparency=1; t.Text=cfg.Title; t.TextColor3=self.ThemeColors.Text; t.Font=Enum.Font.Gotham; t.TextSize=11; t.TextXAlignment=0
            local valT = Instance.new("TextLabel", r); valT.Size=UDim2.new(1,0,0,14); valT.BackgroundTransparency=1; valT.Text=tostring(cfg.Default or 0); valT.TextColor3=self.ThemeColors.Accent; valT.Font=Enum.Font.GothamBold; valT.TextSize=11; valT.TextXAlignment=1
            
            local bg = Instance.new("TextButton", r); bg.Size=UDim2.new(1,0,0,8); bg.Position=UDim2.new(0,0,0,20); bg.BackgroundColor3=self.ThemeColors.Hover; bg.Text=""; self:CreateRound(bg,4); self:CreateStroke(bg)
            local fill = Instance.new("Frame", bg); fill.Size=UDim2.fromScale(0.5, 1); fill.BackgroundColor3=self.ThemeColors.Accent; self:CreateRound(fill,4)
            
            local min, max = cfg.Min or 0, cfg.Max or 100
            local function update(input)
                local pct = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * pct)
                fill.Size = UDim2.fromScale(pct, 1)
                valT.Text = tostring(val)
                if cfg.Callback then cfg.Callback(val) end
            end

            local dragging = false
            bg.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; update(i) end end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
            UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then update(i) end end)

            -- Инициализация ползунка
            local defPct = ((cfg.Default or min) - min) / (max - min)
            fill.Size = UDim2.fromScale(defPct, 1)

            totalHeight = totalHeight + 44
        elseif cfg.Type == "Toggle" then
            local r = Instance.new("TextButton", menu); r.Size=UDim2.new(1,0,0,24); r.BackgroundTransparency=1; r.Text=""
            local t = Instance.new("TextLabel", r); t.Size=UDim2.new(1,-30,1,0); t.BackgroundTransparency=1; t.Text=cfg.Title; t.TextColor3=self.ThemeColors.Text; t.Font=Enum.Font.Gotham; t.TextSize=11; t.TextXAlignment=0
            local box = Instance.new("Frame", r); box.Size=UDim2.fromOffset(16,16); box.Position=UDim2.new(1,-16,0.5,-8); box.BackgroundColor3=cfg.Default and self.ThemeColors.Accent or self.ThemeColors.Hover; self:CreateRound(box,4); self:CreateStroke(box)
            
            local state = cfg.Default or false
            r.MouseButton1Click:Connect(function()
                state = not state
                box.BackgroundColor3 = state and self.ThemeColors.Accent or self.ThemeColors.Hover
                if cfg.Callback then cfg.Callback(state) end
            end)
            totalHeight = totalHeight + 32
        end
    end

    menu.Size = UDim2.fromOffset(200, totalHeight)
    self.Windows.SubSettings = menu

    local conn; conn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if menu.Parent then
                local m = UserInputService:GetMouseLocation()
                local a, s = menu.AbsolutePosition, menu.AbsoluteSize
                if m.X < a.X or m.X > a.X + s.X or m.Y < a.Y or m.Y > a.Y + s.Y then
                    menu:Destroy(); conn:Disconnect()
                end
            else conn:Disconnect() end
        end
    end)
end

