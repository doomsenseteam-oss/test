    local gFrame = Instance.new("Frame", main); gFrame.Size=UDim2.new(1,-20,0,0); gFrame.Position=UDim2.fromOffset(10,32); gFrame.AutomaticSize=Enum.AutomaticSize.Y; gFrame.BackgroundTransparency=1
