    local pad = Instance.new("UIPadding", main); pad.PaddingBottom=UDim.new(0,10)

    for _, item in ipairs(config.Items) do
        local b = Instance.new("TextButton", gFrame); b.Text=item; b.Font=Enum.Font.Gotham; b.TextSize=11; self:CreateRound(b,4); local s=self:CreateStroke(b)
        local function upd()
