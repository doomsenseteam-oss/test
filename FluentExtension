            else b.BackgroundColor3=self.ThemeColors.Main; b.BackgroundTransparency=0; b.TextColor3=self.ThemeColors.SubText; s.Color=self.ThemeColors.Border end
        end
        b.MouseButton1Click:Connect(function() Grid.Selected[item] = not Grid.Selected[item]; upd(); if config.Callback then config.Callback(Grid.Selected) end end)
        upd()
    end
    return Grid
end

