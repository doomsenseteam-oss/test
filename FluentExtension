function FluentExtension:CreateHotkeyWindow()
    if self.HotkeyWindow then return self.HotkeyWindow end

    local frame = Instance.new("Frame", self.OverlayGui)
    frame.Name = "Fluent_HotkeysWindow"
    frame.Size = UDim2.fromOffset(210, 32)
    frame.Position = UDim2.new(0, 15, 0.4, 0)
    frame.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(45, 52, 68)

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Position = UDim2.fromOffset(10, 0)
    title.BackgroundTransparency = 1
    title.Text = "Hotkeys"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left

    local container = Instance.new("Frame", frame)
    container.Position = UDim2.fromOffset(8, 30)
    container.Size = UDim2.new(1, -16, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.BackgroundTransparency = 1

    local layout = Instance.new("UIListLayout", container)
    layout.Padding = UDim.new(0, 4)

    local rows = {}

    RunService.Heartbeat:Connect(function()
        local activeCount = 0

        for optionId, bindData in pairs(self.Hotkeys) do
            if bindData.Visible and bindData.Key and bindData.Key ~= "None" then
                local option = self.Library.Options[optionId]
                local nameText = (option and option.Title) or optionId

                if not rows[optionId] then
                    local row = Instance.new("Frame", container)
                    row.Size = UDim2.new(1, 0, 0, 20)
                    row.BackgroundTransparency = 1

                    local nameLbl = Instance.new("TextLabel", row)
                    nameLbl.Size = UDim2.new(0.6, 0, 1, 0)
                    nameLbl.BackgroundTransparency = 1
                    nameLbl.Font = Enum.Font.Gotham
                    nameLbl.TextSize = 11
                    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

                    local stateLbl = Instance.new("TextLabel", row)
                    stateLbl.Size = UDim2.new(0.4, 0, 1, 0)
                    stateLbl.Position = UDim2.new(0.6, 0, 0, 0)
                    stateLbl.BackgroundTransparency = 1
                    stateLbl.Font = Enum.Font.GothamMedium
                    stateLbl.TextSize = 11
                    stateLbl.TextXAlignment = Enum.TextXAlignment.Right

                    rows[optionId] = { Frame = row, Name = nameLbl, State = stateLbl }
                end

                local r = rows[optionId]
                r.Frame.Visible = true
                r.Name.Text = nameText
                r.State.Text = string.format("[%s] %s", bindData.Key, bindData.Mode or "Toggle")

                if bindData.Active then
                    r.Name.TextColor3 = Color3.fromRGB(255, 255, 255)
                    r.State.TextColor3 = Color3.fromRGB(89, 140, 250)
                else
                    r.Name.TextColor3 = Color3.fromRGB(140, 145, 160)
                    r.State.TextColor3 = Color3.fromRGB(90, 95, 110)
                end

                activeCount = activeCount + 1
            elseif rows[optionId] then
                rows[optionId].Frame.Visible = false
            end
        end

        if activeCount == 0 then
            frame.Visible = false
        else
            frame.Visible = true
            frame.Size = UDim2.fromOffset(210, 34 + (activeCount * 24))
        end
    end)

    self:MakeDraggable(frame, title)
    self.HotkeyWindow = frame
    return frame
end

