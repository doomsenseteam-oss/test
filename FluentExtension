    frame.Position = UDim2.new(0, 15, 0.4, 0)
    frame.BackgroundColor3 = self.ThemeColors.Main
    frame.ClipsDescendants = true
    self:CreateRound(frame); self:CreateStroke(frame)

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 30); title.Position = UDim2.fromOffset(10, 0)
    title.BackgroundTransparency = 1; title.Text = "Hotkeys"; title.TextColor3 = Color3.new(1,1,1)
    title.Font = Enum.Font.GothamBold; title.TextSize = 12; title.TextXAlignment = 0

    local cont = Instance.new("Frame", frame); cont.Position = UDim2.fromOffset(8, 30)
    cont.Size = UDim2.new(1, -16, 0, 0); cont.BackgroundTransparency = 1
    local layout = Instance.new("UIListLayout", cont); layout.Padding = UDim.new(0, 4)

    local rows = {}
    RunService.Heartbeat:Connect(function()
        local active = 0
        for optId, bind in pairs(self.Hotkeys) do
            if bind.Visible and bind.Key ~= "None" then
                local opt = self.Library.Options[optId]
                if not rows[optId] then
                    local r = Instance.new("Frame", cont); r.Size = UDim2.new(1,0,0,18); r.BackgroundTransparency=1
                    local n = Instance.new("TextLabel", r); n.Size=UDim2.new(0.6,0,1,0); n.BackgroundTransparency=1; n.Font=Enum.Font.Gotham; n.TextSize=11; n.TextXAlignment=0
                    local s = Instance.new("TextLabel", r); s.Size=UDim2.new(0.4,0,1,0); s.Position=UDim2.new(0.6,0,0,0); s.BackgroundTransparency=1; s.Font=Enum.Font.GothamMedium; s.TextSize=11; s.TextXAlignment=1
                    rows[optId] = {F=r, N=n, S=s}
                end
                local r = rows[optId]; r.F.Visible = true
                r.N.Text = opt and opt.Title or optId
                r.S.Text = string.format("[%s] %s", bind.Key, bind.Mode)
                if bind.Active then r.N.TextColor3=Color3.new(1,1,1); r.S.TextColor3=self.ThemeColors.Accent
                else r.N.TextColor3=self.ThemeColors.SubText; r.S.TextColor3=Color3.fromRGB(90,95,110) end
                active = active + 1
            elseif rows[optId] then rows[optId].F.Visible = false end
        end
        if active == 0 then frame.Visible = false else frame.Visible = true; frame.Size = UDim2.fromOffset(200, 34 + (active * 22)) end
    end)
    self:MakeDraggable(frame, title)
end

