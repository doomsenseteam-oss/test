local UserInputService   = game:GetService("UserInputService")
local RunService         = game:GetService("RunService")
local Players            = game:GetService("Players")
local StatsService       = game:GetService("Stats")
local MarketplaceService = game:GetService("MarketplaceService")
local CoreGui            = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local FluentExtension = {
    Version = "2.1.0",
    Library = nil,
    OverlayGui = nil,
    HotkeyWindow = nil,
    WatermarkFrame = nil,
    LocalInfoFrame = nil,
    PlaceName = "Roblox Game",
    PlaceIcon = "rbxassetid://6031075931",
}

function FluentExtension:Init(FluentLibrary)
    self.Library = FluentLibrary

    task.spawn(function()
        pcall(function()
            local info = MarketplaceService:GetProductInfo(game.PlaceId)
            if info then
                if info.Name and #info.Name > 0 then self.PlaceName = info.Name end
                if info.IconImageAssetId and info.IconImageAssetId > 0 then
                    self.PlaceIcon = "rbxassetid://" .. tostring(info.IconImageAssetId)
                end
            end
        end)
    end)

    local gui = Instance.new("ScreenGui")
    gui.Name = "FluentExtension_Container"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = CoreGui
    self.OverlayGui = gui

    if FluentLibrary.Elements then
        FluentLibrary.Elements.AddTagGrid = function(s, config)
            return FluentExtension:CreateTagGrid(s.Container, config)
        end
    end

    return self
end

function FluentExtension:MakeDraggable(frame, dragHandle)
    dragHandle = dragHandle or frame
    local dragging, dragStart, startPos, dragInput

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

function FluentExtension:CreateWatermark()
    if self.WatermarkFrame then return self.WatermarkFrame end

    local frame = Instance.new("Frame", self.OverlayGui)
    frame.Name = "Fluent_Watermark"
    frame.Size = UDim2.fromOffset(320, 32)
    frame.Position = UDim2.new(1, -330, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
    frame.BorderSizePixel = 0

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(50, 58, 75)

    local icon = Instance.new("ImageLabel", frame)
    icon.Size = UDim2.fromOffset(18, 18)
    icon.Position = UDim2.fromOffset(8, 7)
    icon.BackgroundTransparency = 1
    icon.Image = self.PlaceIcon

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -34, 1, 0)
    label.Position = UDim2.fromOffset(30, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(240, 240, 240)
    label.TextXAlignment = Enum.TextXAlignment.Left

    local lastTime = tick()
    local frameCount = 0
    local currentFPS = 60

    RunService.Heartbeat:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastTime >= 0.5 then
            currentFPS = math.floor(frameCount / (now - lastTime))
            frameCount = 0
            lastTime = now

            local ping = 0
            pcall(function()
                ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)

            label.Text = string.format("Fluent | %s | %d fps | %d ms", self.PlaceName, currentFPS, ping)
        end
    end)

    self:MakeDraggable(frame)
    self.WatermarkFrame = frame
    return frame
end

function FluentExtension:CreateHotkeyWindow()
    if self.HotkeyWindow then return self.HotkeyWindow end

    local frame = Instance.new("Frame", self.OverlayGui)
    frame.Name = "Fluent_Hotkeys"
    frame.Size = UDim2.fromOffset(210, 32)
    frame.Position = UDim2.new(0, 15, 0.4, 0)
    frame.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(50, 58, 75)

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Position = UDim2.fromOffset(10, 0)
    title.BackgroundTransparency = 1
    title.Text = "Hotkeys"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left

    local container = Instance.new("Frame", frame)
    container.Position = UDim2.fromOffset(8, 30)
    container.Size = UDim2.new(1, -16, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.BackgroundTransparency = 1

    local layout = Instance.new("UIListLayout", container)
    layout.Padding = UDim.new(0, 4)

    local rows = {}

    RunService.Heartbeat:Connect(function()
        if not self.Library or not self.Library.Options then return end

        local activeCount = 0

        for idx, option in pairs(self.Library.Options) do
            if option.Type == "Keybind" and option.Value and option.Value ~= "None" then
                local isActive = option.GetState and option:GetState() or (option.Toggled or false)

                if not rows[idx] then
                    local row = Instance.new("Frame", container)
                    row.Size = UDim2.new(1, 0, 0, 20)
                    row.BackgroundTransparency = 1

                    local nameLbl = Instance.new("TextLabel", row)
                    nameLbl.Size = UDim2.new(0.65, 0, 1, 0)
                    nameLbl.BackgroundTransparency = 1
                    nameLbl.Font = Enum.Font.Gotham
                    nameLbl.TextSize = 11
                    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

                    local stateLbl = Instance.new("TextLabel", row)
                    stateLbl.Size = UDim2.new(0.35, 0, 1, 0)
                    stateLbl.Position = UDim2.new(0.65, 0, 0, 0)
                    stateLbl.BackgroundTransparency = 1
                    stateLbl.Font = Enum.Font.GothamMedium
                    stateLbl.TextSize = 11
                    stateLbl.TextXAlignment = Enum.TextXAlignment.Right

                    rows[idx] = { Frame = row, Name = nameLbl, State = stateLbl }
                end

                local r = rows[idx]
                r.Frame.Visible = true
                r.Name.Text = option.Title or idx
                r.State.Text = string.format("[%s] %s", tostring(option.Value), option.Mode or "Toggle")

                if isActive then
                    r.Name.TextColor3 = Color3.fromRGB(255, 255, 255)
                    r.State.TextColor3 = Color3.fromRGB(89, 140, 250)
                else
                    r.Name.TextColor3 = Color3.fromRGB(140, 145, 160)
                    r.State.TextColor3 = Color3.fromRGB(100, 105, 120)
                end

                activeCount = activeCount + 1
            elseif rows[idx] then
                rows[idx].Frame.Visible = false
            end
        end

        if activeCount == 0 then
            frame.Visible = false
        else
            frame.Visible = true
            frame.Size = UDim2.fromOffset(210, 34 + (activeCount * 24))
        end
    end)

    self:MakeDraggable(frame, title)
    self.HotkeyWindow = frame
    return frame
end

function FluentExtension:AttachContextMenu(fluentElement, optionIdx)
    local targetFrame = fluentElement.Frame or fluentElement
    if not targetFrame then return end

    targetFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            self:OpenHotkeyContextMenu(input.Position, optionIdx)
        end
    end)
end

function FluentExtension:OpenHotkeyContextMenu(position, optionIdx)
    if self.CurrentContextMenu then self.CurrentContextMenu:Destroy() end

    local menu = Instance.new("Frame", self.OverlayGui)
    menu.Name = "Fluent_HotkeyContextMenu"
    menu.Size = UDim2.fromOffset(160, 100)
    menu.Position = UDim2.fromOffset(position.X, position.Y)
    menu.BackgroundColor3 = Color3.fromRGB(22, 25, 34)
    menu.BorderSizePixel = 0
    menu.ZIndex = 2000

    Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", menu)
    stroke.Color = Color3.fromRGB(55, 65, 85)

    local layout = Instance.new("UIListLayout", menu)
    layout.Padding = UDim.new(0, 2)
    local pad = Instance.new("UIPadding", menu)
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)

    local function createBtn(txt, color, callback)
        local btn = Instance.new("TextButton", menu)
        btn.Size = UDim2.new(1, 0, 0, 22)
        btn.BackgroundTransparency = 1
        btn.Text = " " .. txt
        btn.TextColor3 = color or Color3.fromRGB(220, 225, 240)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.ZIndex = 2001
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseEnter:Connect(function()
            btn.BackgroundTransparency = 0.8
            btn.BackgroundColor3 = Color3.fromRGB(89, 140, 250)
        end)
        btn.MouseLeave:Connect(function() btn.BackgroundTransparency = 1 end)
        btn.MouseButton1Click:Connect(function()
            if callback then callback() end
            menu:Destroy()
            self.CurrentContextMenu = nil
        end)
    end

    local option = self.Library.Options[optionIdx]

    createBtn("🔄 Mode: Toggle", Color3.fromRGB(180, 190, 210), function()
        if option and option.Type == "Keybind" then option.Mode = "Toggle" end
    end)

    createBtn("🛑 Mode: Hold", Color3.fromRGB(180, 190, 210), function()
        if option and option.Type == "Keybind" then option.Mode = "Hold" end
    end)

    createBtn("🧹 Reset All Binds", Color3.fromRGB(255, 90, 90), function()
        for _, opt in pairs(self.Library.Options) do
            if opt.Type == "Keybind" then
                opt:SetValue("None", "Toggle")
            end
        end
        self.Library:Notify({ Title = "Hotkeys", Content = "Все бинды сброшены", Duration = 2.5 })
    end)

    self.CurrentContextMenu = menu
end

function FluentExtension:CreateTagGrid(container, config)
    local TagGrid = {
        Title = config.Title or "Tag Grid",
        Items = config.Items or {},
        Selected = config.Default or {},
        Callback = config.Callback or function() end,
        Buttons = {}
    }

    local mainFrame = Instance.new("Frame", container)
    mainFrame.Size = UDim2.new(1, 0, 0, 0)
    mainFrame.AutomaticSize = Enum.AutomaticSize.Y
    mainFrame.BackgroundColor3 = Color3.fromRGB(22, 25, 34)
    mainFrame.BackgroundTransparency = 0.2
    mainFrame.BorderSizePixel = 0

    Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", mainFrame)
    stroke.Color = Color3.fromRGB(45, 52, 68)

    local titleLbl = Instance.new("TextLabel", mainFrame)
    titleLbl.Size = UDim2.new(1, -20, 0, 26)
    titleLbl.Position = UDim2.fromOffset(10, 4)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = TagGrid.Title
    titleLbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    titleLbl.Font = Enum.Font.GothamMedium
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local gridFrame = Instance.new("Frame", mainFrame)
    gridFrame.Size = UDim2.new(1, -20, 0, 0)
    gridFrame.Position = UDim2.fromOffset(10, 32)
    gridFrame.AutomaticSize = Enum.AutomaticSize.Y
    gridFrame.BackgroundTransparency = 1

    local uigrid = Instance.new("UIGridLayout", gridFrame)
    uigrid.CellSize = UDim2.fromOffset(108, 28)
    uigrid.CellPadding = UDim2.fromOffset(6, 6)

    local pad = Instance.new("UIPadding", mainFrame)
    pad.PaddingBottom = UDim.new(0, 10)

    local function updateGrid()
        for name, btnData in pairs(TagGrid.Buttons) do
            local isSel = TagGrid.Selected[name]
            if isSel then
                btnData.Button.BackgroundColor3 = Color3.fromRGB(217, 51, 51)
                btnData.Button.BackgroundTransparency = 0.75
                btnData.Stroke.Color = Color3.fromRGB(217, 51, 51)
                btnData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btnData.Button.BackgroundColor3 = Color3.fromRGB(30, 35, 48)
                btnData.Button.BackgroundTransparency = 0.5
                btnData.Stroke.Color = Color3.fromRGB(50, 58, 75)
                btnData.Button.TextColor3 = Color3.fromRGB(160, 168, 185)
            end
        end
    end

    for _, itemName in ipairs(TagGrid.Items) do
        local tagBtn = Instance.new("TextButton", gridFrame)
        tagBtn.Text = itemName
        tagBtn.Font = Enum.Font.Gotham
        tagBtn.TextSize = 11
        tagBtn.AutoButtonColor = false

        Instance.new("UICorner", tagBtn).CornerRadius = UDim.new(0, 4)
        local btnStroke = Instance.new("UIStroke", tagBtn)

        TagGrid.Buttons[itemName] = { Button = tagBtn, Stroke = btnStroke }

        tagBtn.MouseButton1Click:Connect(function()
            TagGrid.Selected[itemName] = not TagGrid.Selected[itemName]
            updateGrid()
            TagGrid.Callback(TagGrid.Selected)
        end)
    end

    updateGrid()
    return TagGrid
end

