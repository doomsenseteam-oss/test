function FX:CreateWatermark()
    local frame = Instance.new("Frame", self.GUI)
    frame.Size = UDim2.fromOffset(300, 30)
    frame.Position = UDim2.new(1, -320, 0, 15)
    frame.BackgroundColor3 = self.ThemeColors.Main
    self:CreateRound(frame); self:CreateStroke(frame)

    local icon = Instance.new("ImageLabel", frame)
    icon.Size = UDim2.fromOffset(18, 18); icon.Position = UDim2.fromOffset(6, 6)
    icon.BackgroundTransparency = 1; icon.Image = self.GameInfo.Icon

    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(1, -30, 1, 0); lbl.Position = UDim2.fromOffset(30, 0)
    lbl.BackgroundTransparency = 1; lbl.TextColor3 = self.ThemeColors.Text
    lbl.Font = Enum.Font.GothamMedium; lbl.TextSize = 11; lbl.TextXAlignment = 0

    local fc = 0; local lt = tick()
    RunService.Heartbeat:Connect(function()
        fc = fc + 1; local now = tick()
        if now - lt >= 0.5 then
            local fps = math.floor(fc / (now - lt)); fc = 0; lt = now
            local ping = 0; pcall(function() ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            lbl.Text = string.format("Fluent | %s | %d fps | %d ms", self.GameInfo.Name, fps, ping)
        end
    end)
    self:MakeDraggable(frame)
end

