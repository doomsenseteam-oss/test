    local keyRow = Instance.new("Frame", modal)
    keyRow.Size = UDim2.new(1, 0, 0, 22); keyRow.BackgroundTransparency = 1
    local kTitle = Instance.new("TextLabel", keyRow)
    kTitle.Size = UDim2.new(0.5, 0, 1, 0); kTitle.BackgroundTransparency = 1; kTitle.Text = "Key"
    kTitle.Font = Enum.Font.Gotham; kTitle.TextSize = 11; kTitle.TextColor3 = Color3.fromRGB(200, 205, 220); kTitle.TextXAlignment = Enum.TextXAlignment.Left

    local kBtn = Instance.new("TextButton", keyRow)
    kBtn.Size = UDim2.new(0.5, 0, 1, 0); kBtn.Position = UDim2.new(0.5, 0, 0, 0)
    kBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 48); kBtn.Text = bindData.Key or "None"
    kBtn.Font = Enum.Font.GothamBold; kBtn.TextSize = 11; kBtn.TextColor3 = Color3.fromRGB(89, 140, 250)
    Instance.new("UICorner", kBtn).CornerRadius = UDim.new(0, 4)

    local listening = false
    kBtn.MouseButton1Click:Connect(function()
        listening = true
        kBtn.Text = "..."
        local conn
        conn = UserInputService.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                bindData.Key = inp.KeyCode.Name
                kBtn.Text = bindData.Key
                listening = false
                conn:Disconnect()
            elseif inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.MouseButton2 then
                bindData.Key = inp.UserInputType.Name
                kBtn.Text = bindData.Key
                listening = false
                conn:Disconnect()
            end
        end)
    end)

    -- 2. Mode Selector
    local modeRow = Instance.new("Frame", modal)
    modeRow.Size = UDim2.new(1, 0, 0, 22); modeRow.BackgroundTransparency = 1
    local mTitle = Instance.new("TextLabel", modeRow)
    mTitle.Size = UDim2.new(0.5, 0, 1, 0); mTitle.BackgroundTransparency = 1; mTitle.Text = "Mode"
    mTitle.Font = Enum.Font.Gotham; mTitle.TextSize = 11; mTitle.TextColor3 = Color3.fromRGB(200, 205, 220); mTitle.TextXAlignment = Enum.TextXAlignment.Left

    local mBtn = Instance.new("TextButton", modeRow)
    mBtn.Size = UDim2.new(0.5, 0, 1, 0); mBtn.Position = UDim2.new(0.5, 0, 0, 0)
    mBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 48); mBtn.Text = bindData.Mode or "Toggle"
    mBtn.Font = Enum.Font.Gotham; mBtn.TextSize = 11; mBtn.TextColor3 = Color3.fromRGB(220, 225, 240)
    Instance.new("UICorner", mBtn).CornerRadius = UDim.new(0, 4)

    mBtn.MouseButton1Click:Connect(function()
        bindData.Mode = (bindData.Mode == "Toggle") and "Hold" or ((bindData.Mode == "Hold") and "Always" or "Toggle")
        mBtn.Text = bindData.Mode
    end)

    -- 3. Visible Toggle
    local visRow = Instance.new("Frame", modal)
    visRow.Size = UDim2.new(1, 0, 0, 22); visRow.BackgroundTransparency = 1
    local vTitle = Instance.new("TextLabel", visRow)
    vTitle.Size = UDim2.new(0.5, 0, 1, 0); vTitle.BackgroundTransparency = 1; vTitle.Text = "Visible"
    vTitle.Font = Enum.Font.Gotham; vTitle.TextSize = 11; vTitle.TextColor3 = Color3.fromRGB(200, 205, 220); vTitle.TextXAlignment = Enum.TextXAlignment.Left

    local vBtn = Instance.new("TextButton", visRow)
    vBtn.Size = UDim2.new(0.5, 0, 1, 0); vBtn.Position = UDim2.new(0.5, 0, 0, 0)
    vBtn.BackgroundColor3 = bindData.Visible and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(45, 50, 65)
    vBtn.Text = bindData.Visible and "On" or "Off"
    vBtn.Font = Enum.Font.Gotham; vBtn.TextSize = 11; vBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", vBtn).CornerRadius = UDim.new(0, 4)

    vBtn.MouseButton1Click:Connect(function()
        bindData.Visible = not bindData.Visible
        vBtn.Text = bindData.Visible and "On" or "Off"
        vBtn.BackgroundColor3 = bindData.Visible and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(45, 50, 65)
    end)

    -- 4. Delete Action
    local delBtn = Instance.new("TextButton", modal)
    delBtn.Size = UDim2.new(1, 0, 0, 24)
    delBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    delBtn.Text = "Delete Hotkey"
    delBtn.Font = Enum.Font.GothamBold; delBtn.TextSize = 11; delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 4)

    delBtn.MouseButton1Click:Connect(function()
        bindData.Key = "None"
        bindData.Active = false
        modal:Destroy()
        self.CurrentConfigModal = nil
    end)

    self.CurrentConfigModal = modal
end

-- ── 6. КНОПКА ТРЕХ ТОЧЕК (`...` / EXTRA SETTINGS) ─────────────────────────

function FluentExtension:AddSettings(fluentElement, settingsCallback)
    local frame = fluentElement.Frame or fluentElement
    if not frame then return end

    local dotsBtn = Instance.new("TextButton", frame)
    dotsBtn.Name = "Dots_Settings_Btn"
    dotsBtn.Size = UDim2.fromOffset(24, 20)
    dotsBtn.AnchorPoint = Vector2.new(1, 0.5)
    dotsBtn.Position = UDim2.new(1, -50, 0.5, 0)
    dotsBtn.BackgroundTransparency = 1
    dotsBtn.Text = "•••"
    dotsBtn.Font = Enum.Font.GothamBold
    dotsBtn.TextSize = 12
    dotsBtn.TextColor3 = Color3.fromRGB(140, 150, 170)

    dotsBtn.MouseEnter:Connect(function() dotsBtn.TextColor3 = Color3.fromRGB(89, 140, 250) end)
    dotsBtn.MouseLeave:Connect(function() dotsBtn.TextColor3 = Color3.fromRGB(140, 150, 170) end)

    dotsBtn.MouseButton1Click:Connect(function()
        if settingsCallback then
            settingsCallback(dotsBtn.AbsolutePosition)
        end
    end)
end

-- ── 7. МУЛЬТИ-СЕЛЕКТ СЕТКА ТЕГОВ (TAG GRID) ────────────────────────────────

function FluentExtension:CreateTagGrid(container, config)
    local TagGrid = {
        Title = config.Title or "Tag Grid",
        Items = config.Items or {},
        Selected = config.Default or {},
        Callback = config.Callback or function() end,
        Buttons = {}
    }

    local mainFrame = Instance.new("Frame", container)
    mainFrame.Size = UDim2.new(1, 0, 0, 0)
    mainFrame.AutomaticSize = Enum.AutomaticSize.Y
    mainFrame.BackgroundColor3 = Color3.fromRGB(18, 21, 28)
    mainFrame.BackgroundTransparency = 0.2
    mainFrame.BorderSizePixel = 0

    Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", mainFrame)
    stroke.Color = Color3.fromRGB(45, 52, 68)

    local titleLbl = Instance.new("TextLabel", mainFrame)
    titleLbl.Size = UDim2.new(1, -20, 0, 26)
    titleLbl.Position = UDim2.fromOffset(10, 4)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = TagGrid.Title
    titleLbl.TextColor3 = Color3.fromRGB(240, 240, 240)
    titleLbl.Font = Enum.Font.GothamMedium
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local gridFrame = Instance.new("Frame", mainFrame)
    gridFrame.Size = UDim2.new(1, -20, 0, 0)
    gridFrame.Position = UDim2.fromOffset(10, 32)
    gridFrame.AutomaticSize = Enum.AutomaticSize.Y
    gridFrame.BackgroundTransparency = 1

    local uigrid = Instance.new("UIGridLayout", gridFrame)
    uigrid.CellSize = UDim2.fromOffset(108, 28)
    uigrid.CellPadding = UDim2.fromOffset(6, 6)

    local pad = Instance.new("UIPadding", mainFrame)
    pad.PaddingBottom = UDim.new(0, 10)

    local function updateGrid()
        for name, btnData in pairs(TagGrid.Buttons) do
            local isSel = TagGrid.Selected[name]
            if isSel then
                btnData.Button.BackgroundColor3 = Color3.fromRGB(217, 51, 51)
                btnData.Button.BackgroundTransparency = 0.75
                btnData.Stroke.Color = Color3.fromRGB(217, 51, 51)
                btnData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btnData.Button.BackgroundColor3 = Color3.fromRGB(28, 32, 44)
                btnData.Button.BackgroundTransparency = 0.5
                btnData.Stroke.Color = Color3.fromRGB(48, 55, 72)
                btnData.Button.TextColor3 = Color3.fromRGB(150, 160, 180)
            end
        end
    end

    for _, itemName in ipairs(TagGrid.Items) do
        local tagBtn = Instance.new("TextButton", gridFrame)
        tagBtn.Text = itemName
        tagBtn.Font = Enum.Font.Gotham
        tagBtn.TextSize = 11
        tagBtn.AutoButtonColor = false

        Instance.new("UICorner", tagBtn).CornerRadius = UDim.new(0, 4)
        local btnStroke = Instance.new("UIStroke", tagBtn)

        TagGrid.Buttons[itemName] = { Button = tagBtn, Stroke = btnStroke }

        tagBtn.MouseButton1Click:Connect(function()
            TagGrid.Selected[itemName] = not TagGrid.Selected[itemName]
            updateGrid()
            TagGrid.Callback(TagGrid.Selected)
        end)
    end

    updateGrid()
    return TagGrid
end

