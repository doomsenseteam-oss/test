-- ── 1. CORE ENGINE & INITIALIZATION ─────────────────────────────────────────

function FX:Init(FluentLib)
    self.Library = FluentLib

    task.spawn(function()
        pcall(function()
            local info = MarketplaceService:GetProductInfo(game.PlaceId)
            if info then
                if info.Name then self.GameInfo.Name = info.Name end
                if info.IconImageAssetId then self.GameInfo.Icon = "rbxassetid://" .. info.IconImageAssetId end
            end
        end)
    end)

    local container = Instance.new("ScreenGui")
    container.Name = "FluentExtension_Core"
    container.ResetOnSpawn = false
    container.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    container.Parent = CoreGui
    self.GUI = container

    self:InjectIntoFluent()
    self:StartBindProcessor()

    return self
end

function FX:MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function FX:CreateRound(parent, radius)
    local uic = Instance.new("UICorner")
    uic.CornerRadius = UDim.new(0, radius or 6)
    uic.Parent = parent
    return uic
end

function FX:CreateStroke(parent, color, thickness)
    local uis = Instance.new("UIStroke")
    uis.Color = color or self.ThemeColors.Border
    uis.Thickness = thickness or 1
    uis.Parent = parent
    return uis
end

function FX:CloseAllModals(exception)
    for _, name in ipairs({"ContextMenu", "MiniMenu", "SubSettings"}) do
        if self.Windows[name] and self.Windows[name] ~= exception then
            self.Windows[name]:Destroy()
            self.Windows[name] = nil
        end
    end
end

-- ── 2. FLUENT NATIVE HOOKS (АВТО-ИНТЕГРАЦИЯ) ────────────────────────────────

function FX:InjectIntoFluent()
    if not self.Library or not self.Library.Elements then return end

    -- Перехватчик создания элементов для авто-добавления ПКМ
    for _, elName in ipairs({"AddToggle", "AddSlider", "AddDropdown", "AddColorpicker"}) do
        local original = self.Library.Elements[elName]
        if original then
            self.Library.Elements[elName] = function(tab, idx, config)
                local element = original(tab, idx, config)
                -- У элементов Fluent обычно есть .Frame или .Container
                local frame = element.Frame or element.Container
                if frame then
                    self:AttachContextMenu(frame, idx, element, config)
                end
                return element
            end
        end
    end

    -- Нативный TagGrid
    self.Library.Elements.AddTagGrid = function(tab, config)
        return self:CreateTagGrid(tab.Container, config)
    end
end

-- ── 3. KEYBIND PROCESSOR (ОБРАБОТКА НАЖАТИЙ) ────────────────────────────────

function FX:StartBindProcessor()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        local key = input.KeyCode.Name ~= "Unknown" and input.KeyCode.Name or input.UserInputType.Name

        for optId, bind in pairs(self.Hotkeys) do
            if bind.Key == key then
                local element = self.Library.Options[optId]
                if element and element.SetValue then
                    if bind.Mode == "Toggle" then
                        bind.Active = not bind.Active
                        if bind.TargetValue ~= nil then
                            if bind.Active then element:SetValue(bind.TargetValue) else element:SetValue(element.Default or false) end
                        else
                            element:SetValue(not element.Value)
                        end
                    elseif bind.Mode == "Hold" then
                        bind.Active = true
                        if bind.TargetValue ~= nil then element:SetValue(bind.TargetValue) else element:SetValue(true) end
                    end
                end
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input, gpe)
        if gpe then return end
        local key = input.KeyCode.Name ~= "Unknown" and input.KeyCode.Name or input.UserInputType.Name
        for optId, bind in pairs(self.Hotkeys) do
            if bind.Key == key and bind.Mode == "Hold" then
                bind.Active = false
                local element = self.Library.Options[optId]
                if element and element.SetValue then
                    if bind.TargetValue ~= nil then element:SetValue(element.Default or false) else element:SetValue(false) end
                end
            end
        end
    end)
end

-- ── 4. CONTEXT MENU (МЕНЮ ПКМ) ──────────────────────────────────────────────

function FX:AttachContextMenu(frame, optId, elementObj, config)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            self:OpenContextMenu(input.Position, optId, elementObj, config)
        end
    end)
end

function FX:OpenContextMenu(pos, optId, elementObj, config)
    self:CloseAllModals()

    if not self.Hotkeys[optId] then
        self.Hotkeys[optId] = { Key = "None", Mode = "Toggle", Visible = true, Active = false, TargetValue = nil }
    end
    local bind = self.Hotkeys[optId]

    local menu = Instance.new("Frame", self.GUI)
    menu.Name = "ContextMenu"
    menu.Size = UDim2.fromOffset(170, 130)
    menu.Position = UDim2.fromOffset(pos.X, pos.Y)
    menu.BackgroundColor3 = self.ThemeColors.Main
    menu.BorderSizePixel = 0
    menu.ZIndex = 1000
    self:CreateRound(menu); self:CreateStroke(menu)

    local layout = Instance.new("UIListLayout", menu)
    layout.Padding = UDim.new(0, 2); layout.SortOrder = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", menu)
    pad.PaddingTop = UDim.new(0, 4); pad.PaddingBottom = UDim.new(0, 4); pad.PaddingLeft = UDim.new(0, 4); pad.PaddingRight = UDim.new(0, 4)

    local function addBtn(icon, text, color, cb)
        local b = Instance.new("TextButton", menu)
        b.Size = UDim2.new(1, 0, 0, 24); b.BackgroundTransparency = 1
        b.Text = string.format("  %s   %s", icon, text)
        b.TextColor3 = color or self.ThemeColors.Text; b.Font = Enum.Font.Gotham; b.TextSize = 11; b.TextXAlignment = Enum.TextXAlignment.Left; b.ZIndex = 1001
        self:CreateRound(b, 4)
        b.MouseEnter:Connect(function() b.BackgroundTransparency = 0; b.BackgroundColor3 = self.ThemeColors.Hover end)
        b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
        b.MouseButton1Click:Connect(function() menu:Destroy(); if cb then cb() end end)
    end

    local keyText = bind.Key ~= "None" and ("["..bind.Key.."] >") or "Unbound >"

    addBtn("⌨", keyText, self.ThemeColors.Text, function() self:OpenMiniMenu(pos, optId, elementObj, config) end)
    addBtn("📋", "All Hotkeys", self.ThemeColors.Text, function() self:CreateAllHotkeysManager() end)
    addBtn("➕", "New Hotkey", self.ThemeColors.Text, function() self:OpenMiniMenu(pos, optId, elementObj, config) end)
    addBtn("🔗", "Copy Path", self.ThemeColors.SubText, function()
        pcall(function() setclipboard('ui.find("'..optId..'")') end)
        self.Library:Notify({Title="Copied", Content="Path copied to clipboard", Duration=2})
    end)
    addBtn("🔄", "Reset", self.ThemeColors.Danger, function()
        bind.Key = "None"; bind.Active = false
        if elementObj.SetValue then elementObj:SetValue(elementObj.Default) end
    end)

    self.Windows.ContextMenu = menu

    local conn; conn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if menu.Parent then
                local m = UserInputService:GetMouseLocation()
                local a, s = menu.AbsolutePosition, menu.AbsoluteSize
                if m.X < a.X or m.X > a.X + s.X or m.Y < a.Y or m.Y > a.Y + s.Y then
                    menu:Destroy(); conn:Disconnect()
                end
            else conn:Disconnect() end
        end
    end)
end

