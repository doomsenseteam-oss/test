-- ── ИНИЦИАЛИЗАЦИЯ ────────────────────────────────────────────────────────────

function FluentExtension:Init(FluentLibrary)
    self.Library = FluentLibrary

    task.spawn(function()
        pcall(function()
            local info = MarketplaceService:GetProductInfo(game.PlaceId)
            if info then
                if info.Name and #info.Name > 0 then self.PlaceName = info.Name end
                if info.IconImageAssetId and info.IconImageAssetId > 0 then
                    self.PlaceIcon = "rbxassetid://" .. tostring(info.IconImageAssetId)
                end
            end
        end)
    end)

    local gui = Instance.new("ScreenGui")
    gui.Name = "FluentExtension_Container"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = CoreGui
    self.OverlayGui = gui

    -- Регистрация нативных методов во Fluent
    if FluentLibrary.Elements then
        FluentLibrary.Elements.AddTagGrid = function(s, config)
            return FluentExtension:CreateTagGrid(s.Container, config)
        end
    end

    -- Глобальный слушатель нажатий клавиш для системы Биндов
    self:StartHotkeyListener()

    return self
end

-- ── ДВИЖОК ПЕРЕТАСКИВАНИЯ МЫШЬЮ ──────────────────────────────────────────────

function FluentExtension:MakeDraggable(frame, dragHandle)
    dragHandle = dragHandle or frame
    local dragging, dragStart, startPos, dragInput

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- ── СИСТЕМА ОБРАБОТКИ БИНДОВ И ТРИГГЕРОВ ────────────────────────────────────

function FluentExtension:StartHotkeyListener()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        local keyCode = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name or nil
        local userInputType = input.UserInputType.Name

        local keyName = keyCode or userInputType

        for optionId, bindData in pairs(self.Hotkeys) do
            if bindData.Key and bindData.Key == keyName then
                local option = self.Library.Options[optionId]
                if option then
                    if bindData.Mode == "Toggle" then
                        bindData.Active = not bindData.Active
                        if option.SetValue then
                            local val = bindData.Active and (bindData.TargetValue ~= nil and bindData.TargetValue or true) or false
                            option:SetValue(val)
                        end
                    elseif bindData.Mode == "Hold" then
                        bindData.Active = true
                        if option.SetValue then
                            local val = bindData.TargetValue ~= nil and bindData.TargetValue or true
                            option:SetValue(val)
                        end
                    end
                end
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input, gpe)
        if gpe then return end
        local keyCode = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name or nil
        local userInputType = input.UserInputType.Name
        local keyName = keyCode or userInputType

        for optionId, bindData in pairs(self.Hotkeys) do
            if bindData.Key and bindData.Key == keyName and bindData.Mode == "Hold" then
                bindData.Active = false
                local option = self.Library.Options[optionId]
                if option and option.SetValue then
                    option:SetValue(false)
                end
            end
        end
    end)
end

-- ── 1. ВОДЯНОЙ ЗНАК (WATERMARK) ──────────────────────────────────────────────

function FluentExtension:CreateWatermark()
    if self.WatermarkFrame then return self.WatermarkFrame end

    local frame = Instance.new("Frame", self.OverlayGui)
    frame.Name = "Fluent_Watermark"
    frame.Size = UDim2.fromOffset(320, 30)
    frame.Position = UDim2.new(1, -330, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
    frame.BorderSizePixel = 0

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(45, 52, 68)

    local icon = Instance.new("ImageLabel", frame)
    icon.Size = UDim2.fromOffset(16, 16)
    icon.Position = UDim2.fromOffset(8, 7)
    icon.BackgroundTransparency = 1
    icon.Image = self.PlaceIcon

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -34, 1, 0)
    label.Position = UDim2.fromOffset(30, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 11
    label.TextColor3 = Color3.fromRGB(230, 235, 245)
    label.TextXAlignment = Enum.TextXAlignment.Left

    local lastTime = tick()
    local frameCount = 0

    RunService.Heartbeat:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastTime >= 0.5 then
            local currentFPS = math.floor(frameCount / (now - lastTime))
            frameCount = 0
            lastTime = now

            local ping = 0
            pcall(function() ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()) end)

            label.Text = string.format("Fluent | %s | %d fps | %d ms", self.PlaceName, currentFPS, ping)
        end
    end)

    self:MakeDraggable(frame)
    self.WatermarkFrame = frame
    return frame
end

