function FluentHUD:BuildHUDSection(tab)
    assert(self.Library, "Must set FluentHUD.Library before building section!")
    self:LoadSettings()
    self:InitVisuals()

    local section = tab:AddSection("HUD & Overlay Manager")

    -- 1. Драг режим
    section:AddToggle("HUD_EditMode", {
        Title       = "Unlock HUD Drag Positions",
        Description = "Разблокирует оверлеи для перетаскивания мышкой.",
        Default     = self.EditMode,
        Callback    = function(val) self:SetEditMode(val) end
    })

    -- 2. Watermark
    section:AddToggle("HUD_WM_Enable", {
        Title       = "Show Watermark",
        Default     = self.Settings.WatermarkEnabled,
        Callback    = function(val)
            self.Settings.WatermarkEnabled = val
            if self.Elements.WatermarkFrame then self.Elements.WatermarkFrame.Visible = val end
            self:SaveSettings()
        end
    })

    section:AddToggle("HUD_WM_FPS",  { Title = "Watermark: Show FPS",  Default = self.Settings.WatermarkShowFPS,  Callback = function(v) self.Settings.WatermarkShowFPS = v; self:SaveSettings() end })
    section:AddToggle("HUD_WM_Ping", { Title = "Watermark: Show Ping", Default = self.Settings.WatermarkShowPing, Callback = function(v) self.Settings.WatermarkShowPing = v; self:SaveSettings() end })
    section:AddToggle("HUD_WM_Time", { Title = "Watermark: Show Time", Default = self.Settings.WatermarkShowTime, Callback = function(v) self.Settings.WatermarkShowTime = v; self:SaveSettings() end })
    section:AddToggle("HUD_WM_User", { Title = "Watermark: Show User", Default = self.Settings.WatermarkShowUser, Callback = function(v) self.Settings.WatermarkShowUser = v; self:SaveSettings() end })

    -- 3. Keybinds List
    section:AddToggle("HUD_KB_Enable", {
        Title       = "Show Keybinds Overlay",
        Default     = self.Settings.KeybindsEnabled,
        Callback    = function(val)
            self.Settings.KeybindsEnabled = val
            if self.Elements.KeybindsFrame then self.Elements.KeybindsFrame.Visible = val end
            self:SaveSettings()
        end
    })

    section:AddToggle("HUD_KB_Inactive", {
        Title       = "Show Inactive Keybinds",
        Description = "Отображает отключенные бинды серого цвета.",
        Default     = self.Settings.KeybindsShowInactive,
        Callback    = function(val)
            self.Settings.KeybindsShowInactive = val
            self:SaveSettings()
        end
    })

    -- 4. Сброс
    section:AddButton({
        Title       = "Reset HUD Positions",
        Description = "Сбрасывает координаты оверлеев по умолчанию.",
        Callback    = function()
            self.Settings.WatermarkPos = { X = 0.78, Y = 0.02 }
            self.Settings.KeybindsPos = { X = 0.02, Y = 0.35 }
            if self.Elements.WatermarkFrame then self.Elements.WatermarkFrame.Position = UDim2.fromScale(0.78, 0.02) end
            if self.Elements.KeybindsFrame then self.Elements.KeybindsFrame.Position = UDim2.fromScale(0.02, 0.35) end
            self:SaveSettings()
        end
    })
end

-- Сборка настроек мобильных кнопок строго в меню (по примеру из v2.3_OM.txt)
function FluentHUD:BuildMobileSection(tab)
    local sec = tab:AddSection("Mobile Button Controls")

    sec:AddToggle("Mob_EditMode", {
        Title    = "Edit Mode (Drag Buttons)",
        Default  = self.EditMode,
        Callback = function(val) self:SetEditMode(val) end
    })

    local function AddBtnEditor(id)
        sec:AddParagraph({ Title = id .. " Button", Content = "" })

        sec:AddSlider("MobSize_" .. id, {
            Title   = id .. " Size (px)",
            Default = self.MobileSettings[id] and self.MobileSettings[id].Size or 50,
            Min = 20, Max = 100, Rounding = 0,
            Callback = function(v)
                if not self.MobileSettings[id] then self.MobileSettings[id] = {} end
                self.MobileSettings[id].Size = v
                if self.MobileButtons[id] then self.MobileButtons[id].UpdateConfig() end
                self:SaveSettings()
            end
        })

        sec:AddSlider("MobTransp_" .. id, {
            Title   = id .. " Transparency %",
            Default = self.MobileSettings[id] and self.MobileSettings[id].Transp or 0,
            Min = 0, Max = 100, Rounding = 0,
            Callback = function(v)
                if not self.MobileSettings[id] then self.MobileSettings[id] = {} end
                self.MobileSettings[id].Transp = v
                if self.MobileButtons[id] then self.MobileButtons[id].UpdateConfig() end
                self:SaveSettings()
            end
        })

        sec:AddToggle("MobEnable_" .. id, {
            Title   = "Show " .. id .. " Button",
            Default = self.MobileSettings[id] and self.MobileSettings[id].Enabled or true,
            Callback = function(v)
                if not self.MobileSettings[id] then self.MobileSettings[id] = {} end
                self.MobileSettings[id].Enabled = v
                if self.MobileButtons[id] then self.MobileButtons[id].UpdateConfig() end
                self:SaveSettings()
            end
        })
    end

    local btnList = { "Menu", "HideUI", "Fly", "Speed", "ART", "Teleport", "AH", "Anim", "Silver" }
    for _, btnName in ipairs(btnList) do
        AddBtnEditor(btnName)
    end
end

return FluentHUD
