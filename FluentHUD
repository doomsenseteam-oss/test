-- 2. БЕЗЛАГОВЫЙ ДВИЖОК DRAG (БЕЗ СКАЧКОВ И РЫВКОВ)
-- ═══════════════════════════════════════════════════════════════════════════

function FluentHUD:MakeDraggable(frame, onReleaseCallback)
    frame.Active = true -- Блокировка пробития клика в игру

    local dragging = false
    local dragOffset = Vector2.zero

    frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = true
            
            -- Точный расчет смещения клика относительно рамки (исключает прыжок)
            local mousePos = Vector2.new(input.Position.X, input.Position.Y)
            dragOffset = mousePos - frame.AbsolutePosition

            local changedConn
            changedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if changedConn then changedConn:Disconnect() end
                    if onReleaseCallback then
                        local vp = Camera.ViewportSize
                        if vp.X > 0 and vp.Y > 0 then
                            local relX = frame.AbsolutePosition.X / vp.X
                            local relY = frame.AbsolutePosition.Y / vp.Y
                            onReleaseCallback(relX, relY)
                        end
                    end
                end
            end)
        end
    end)

    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local vp = Camera.ViewportSize
            local mousePos = Vector2.new(input.Position.X, input.Position.Y)
            local targetPos = mousePos - dragOffset

            local clampedX = math.clamp(targetPos.X, 0, math.max(0, vp.X - frame.AbsoluteSize.X))
            local clampedY = math.clamp(targetPos.Y, 0, math.max(0, vp.Y - frame.AbsoluteSize.Y))

            frame.Position = UDim2.fromOffset(clampedX, clampedY)
        end
    end))
end

