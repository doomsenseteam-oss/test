function FluentHUD:CreateMobileButton(id, defaultPos, callback)
    if not self.ScreenGui then self:InitVisuals() end

    local cfg    = self.MobileSettings[id] or { Size = 50, Transp = 0, Enabled = true }
    local sizePx = cfg.Size

    local canvas = Instance.new("CanvasGroup")
    canvas.Name                   = "MobBtn_" .. id
    canvas.Active                 = true
    canvas.Size                   = UDim2.fromOffset(sizePx, sizePx)
    canvas.Position               = defaultPos
    canvas.BackgroundTransparency = 1
    canvas.GroupTransparency      = cfg.Transp / 100
    canvas.Visible                = cfg.Enabled
    canvas.ZIndex                 = 20
    canvas.Parent                 = self.ScreenGui

    local bgFrame = Instance.new("Frame", canvas)
    bgFrame.Size                   = UDim2.new(1, -6, 1, -6)
    bgFrame.AnchorPoint            = Vector2.new(0.5, 0.5)
    bgFrame.Position               = UDim2.new(0.5, 0, 0.5, 0)
    bgFrame.BorderSizePixel        = 0
    bgFrame.BackgroundTransparency = 0.4
    bgFrame.ZIndex                 = 21
    Instance.new("UICorner", bgFrame).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", bgFrame)
    stroke.Thickness = 2

    local iconLabel = Instance.new("ImageLabel", canvas)
    iconLabel.Size                   = UDim2.new(0.6, 0, 0.6, 0)
    iconLabel.AnchorPoint            = Vector2.new(0.5, 0.5)
    iconLabel.Position               = UDim2.new(0.5, 0, 0.5, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Image                  = MOB_ICONS[id] or ""
    iconLabel.ZIndex                 = 22

    local clickBtn = Instance.new("TextButton", canvas)
    clickBtn.Size                   = UDim2.fromScale(1, 1)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text                   = ""
    clickBtn.ZIndex                 = 25

    local dragHitbox = Instance.new("TextButton", canvas)
    dragHitbox.Size                   = UDim2.fromScale(1.2, 1.2)
    dragHitbox.Position               = UDim2.fromScale(-0.1, -0.1)
    dragHitbox.BackgroundColor3       = Color3.fromRGB(255, 180, 0)
    dragHitbox.BackgroundTransparency = 0.6
    dragHitbox.Text                   = "MOVE"
    dragHitbox.Font                   = Enum.Font.GothamBold
    dragHitbox.TextSize               = 9
    dragHitbox.TextColor3             = Color3.fromRGB(0, 0, 0)
    dragHitbox.Visible                = self.EditMode
    dragHitbox.ZIndex                 = 30
    Instance.new("UICorner", dragHitbox).CornerRadius = UDim.new(1, 0)

    local isActive = false

    local function ApplyColors()
        local theme = self:GetThemeColors()
        bgFrame.BackgroundColor3 = isActive and theme.Accent or theme.Main
        stroke.Color             = isActive and theme.Text or theme.Stroke
        iconLabel.ImageColor3    = theme.Text
    end

    clickBtn.MouseButton1Click:Connect(function()
        if not self.EditMode and callback then callback() end
    end)

    self:MakeDraggable(canvas, function(relX, relY)
        -- Перетаскивание мобильных кнопок
    end)

    ApplyColors()

    self.MobileButtons[id] = {
        Canvas       = canvas,
        UpdateColors = ApplyColors,
        SetState     = function(val) isActive = val; ApplyColors() end,
        UpdateConfig = function()
            local c = self.MobileSettings[id]
            if c then
                canvas.Size              = UDim2.fromOffset(c.Size, c.Size)
                canvas.GroupTransparency = c.Transp / 100
                canvas.Visible           = c.Enabled
            end
        end,
        SetDragMode  = function(state)
            dragHitbox.Visible = state
        end
    }
end

