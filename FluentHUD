function FluentHUD:GetThemeColors()
    if not self.Settings.UseThemeColor then
        return {
            Accent = self.Settings.CustomAccent,
            Main   = Color3.fromRGB(25, 25, 25),
            Text   = Color3.fromRGB(240, 240, 240),
            Stroke = Color3.fromRGB(60, 60, 60),
            Holder = Color3.fromRGB(15, 15, 15)
        }
    end

    local themeName = (self.Library and self.Library.Theme) or "Dark"
    local colors = {
        Accent = Color3.fromRGB(96, 205, 255),
        Main   = Color3.fromRGB(30, 30, 30),
        Text   = Color3.fromRGB(240, 240, 240),
        Stroke = Color3.fromRGB(60, 60, 60),
        Holder = Color3.fromRGB(20, 20, 20)
    }

    if themeName == "Light" then
        colors.Accent = Color3.fromRGB(0, 103, 192)
        colors.Main   = Color3.fromRGB(235, 235, 235)
        colors.Text   = Color3.fromRGB(20, 20, 20)
        colors.Stroke = Color3.fromRGB(180, 180, 180)
        colors.Holder = Color3.fromRGB(210, 210, 210)
    elseif themeName == "Darker" then
        colors.Accent = Color3.fromRGB(72, 138, 182)
        colors.Main   = Color3.fromRGB(20, 20, 20)
        colors.Stroke = Color3.fromRGB(45, 45, 45)
        colors.Holder = Color3.fromRGB(12, 12, 12)
    elseif themeName == "Aqua" then
        colors.Accent = Color3.fromRGB(60, 165, 165)
        colors.Main   = Color3.fromRGB(25, 45, 45)
        colors.Stroke = Color3.fromRGB(50, 95, 95)
        colors.Holder = Color3.fromRGB(15, 30, 30)
    elseif themeName == "Amethyst" then
        colors.Accent = Color3.fromRGB(97, 62, 167)
        colors.Main   = Color3.fromRGB(35, 25, 50)
        colors.Stroke = Color3.fromRGB(80, 55, 115)
        colors.Holder = Color3.fromRGB(20, 15, 30)
    elseif themeName == "Rose" then
        colors.Accent = Color3.fromRGB(180, 55, 90)
        colors.Main   = Color3.fromRGB(40, 25, 30)
        colors.Stroke = Color3.fromRGB(110, 50, 70)
        colors.Holder = Color3.fromRGB(25, 15, 20)
    end

    return colors
end

function FluentHUD:UpdateTheme()
    local theme = self:GetThemeColors()

    if self.Elements.WatermarkFrame then
        self.Elements.WatermarkFrame.BackgroundColor3 = theme.Main
        self.Elements.WatermarkText.TextColor3         = theme.Text
        if not self.EditMode then
            self.Elements.WatermarkStroke.Color = theme.Stroke
        end
    end

    if self.Elements.KeybindsFrame then
        self.Elements.KeybindsFrame.BackgroundColor3 = theme.Main
        self.Elements.KeybindsTitle.TextColor3       = theme.Text
        self.Elements.KeybindsLine.BackgroundColor3  = theme.Stroke
        if not self.EditMode then
            self.Elements.KeybindsStroke.Color = theme.Stroke
        end
    end

    for id, btn in pairs(self.MobileButtons) do
        if btn.UpdateColors then btn.UpdateColors() end
    end
end

