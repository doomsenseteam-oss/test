function FluentHUD:InitVisuals()
    if self.ScreenGui then return end

    local screen = Instance.new("ScreenGui")
    screen.Name           = "FluentHUD_Overlay_v2"
    screen.ResetOnSpawn   = false
    screen.IgnoreGuiInset = true
    screen.DisplayOrder   = 100
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent         = CoreGui
    self.ScreenGui        = screen

    local vp = Camera.ViewportSize

    ---------------------------------------------------------------------------
    -- WATERMARK
    ---------------------------------------------------------------------------
    local wmFrame = Instance.new("Frame")
    wmFrame.Name                   = "Watermark"
    wmFrame.Active                 = true
    wmFrame.Size                   = UDim2.fromOffset(200, 28)
    wmFrame.Position               = UDim2.fromScale(self.Settings.WatermarkPos.X, self.Settings.WatermarkPos.Y)
    wmFrame.BackgroundColor3       = Color3.fromRGB(30, 30, 30)
    wmFrame.BackgroundTransparency = 0.2
    wmFrame.BorderSizePixel        = 0
    wmFrame.Visible                = self.Settings.WatermarkEnabled
    wmFrame.ZIndex                 = 10
    wmFrame.Parent                 = screen

    local wmCorner = Instance.new("UICorner", wmFrame)
    wmCorner.CornerRadius = UDim.new(0, 6)

    local wmStroke = Instance.new("UIStroke", wmFrame)
    wmStroke.Thickness = 1
    wmStroke.Color     = Color3.fromRGB(60, 60, 60)

    local wmText = Instance.new("TextLabel", wmFrame)
    wmText.Size                   = UDim2.fromScale(1, 1)
    wmText.BackgroundTransparency = 1
    wmText.Font                   = Enum.Font.GothamMedium
    wmText.TextSize               = 12
    wmText.TextColor3             = Color3.fromRGB(240, 240, 240)
    wmText.Text                   = "Fluent | Init..."
    wmText.ZIndex                 = 11

    self:MakeDraggable(wmFrame, function(relX, relY)
        self.Settings.WatermarkPos = { X = relX, Y = relY }
        self:SaveSettings()
    end)

    self.Elements.WatermarkFrame  = wmFrame
    self.Elements.WatermarkText   = wmText
    self.Elements.WatermarkStroke = wmStroke

    ---------------------------------------------------------------------------
    -- KEYBINDS OVERLAY (ИСПРАВЛЕННЫЙ СМОТР И СМОТР ПОЗИЦИИ)
    ---------------------------------------------------------------------------
    local kbFrame = Instance.new("Frame")
    kbFrame.Name                   = "Keybinds"
    kbFrame.Active                 = true
    kbFrame.Size                   = UDim2.fromOffset(180, 40)
    kbFrame.Position               = UDim2.fromScale(self.Settings.KeybindsPos.X, self.Settings.KeybindsPos.Y)
    kbFrame.BackgroundColor3       = Color3.fromRGB(30, 30, 30)
    kbFrame.BackgroundTransparency = 0.2
    kbFrame.BorderSizePixel        = 0
    kbFrame.Visible                = self.Settings.KeybindsEnabled
    kbFrame.ZIndex                 = 10
    kbFrame.Parent                 = screen

    local kbCorner = Instance.new("UICorner", kbFrame)
    kbCorner.CornerRadius = UDim.new(0, 6)

    local kbStroke = Instance.new("UIStroke", kbFrame)
    kbStroke.Thickness = 1
    kbStroke.Color     = Color3.fromRGB(60, 60, 60)

    local kbTitle = Instance.new("TextLabel", kbFrame)
    kbTitle.Size                   = UDim2.new(1, 0, 0, 22)
    kbTitle.BackgroundTransparency = 1
    kbTitle.Font                   = Enum.Font.GothamBold
    kbTitle.TextSize               = 12
    kbTitle.TextColor3             = Color3.fromRGB(240, 240, 240)
    kbTitle.Text                   = "Keybinds"
    kbTitle.ZIndex                 = 11

    local kbLine = Instance.new("Frame", kbFrame)
    kbLine.Size             = UDim2.new(1, -12, 0, 1)
    kbLine.Position         = UDim2.new(0, 6, 0, 22)
    kbLine.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    kbLine.BorderSizePixel  = 0
    kbLine.ZIndex           = 11

    local kbContainer = Instance.new("Frame", kbFrame)
    kbContainer.Position               = UDim2.new(0, 6, 0, 26)
    kbContainer.Size                   = UDim2.new(1, -12, 0, 0)
    kbContainer.BackgroundTransparency = 1
    kbContainer.ZIndex                 = 11

    local kbLayout = Instance.new("UIListLayout", kbContainer)
    kbLayout.SortOrder = Enum.SortOrder.LayoutOrder
    kbLayout.Padding   = UDim.new(0, 2)

    self:MakeDraggable(kbFrame, function(relX, relY)
        self.Settings.KeybindsPos = { X = relX, Y = relY }
        self:SaveSettings()
    end)

    self.Elements.KeybindsFrame     = kbFrame
    self.Elements.KeybindsTitle     = kbTitle
    self.Elements.KeybindsLine      = kbLine
    self.Elements.KeybindsContainer = kbContainer
    self.Elements.KeybindsStroke    = kbStroke

    ---------------------------------------------------------------------------
    -- RENDER LOOP (FPS, PING, KEYBINDS SYNC)
    ---------------------------------------------------------------------------
    local lastFpsCheck = tick()
    local fps = 60

    table.insert(self.Connections, RunService.RenderStepped:Connect(function(dt)
        -- Watermark
        if self.Settings.WatermarkEnabled then
            if tick() - lastFpsCheck >= 0.25 then
                fps = math.floor(1 / dt)
                lastFpsCheck = tick()

                local ping = 0
                pcall(function()
                    ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
                end)

                local timeStr = os.date("%H:%M:%S")
                local userStr = LocalPlayer and LocalPlayer.Name or "User"

                local parts = {}
                if self.Settings.WatermarkShowUser then table.insert(parts, userStr) end
                if self.Settings.WatermarkShowFPS  then table.insert(parts, fps .. " FPS") end
                if self.Settings.WatermarkShowPing then table.insert(parts, ping .. " ms") end
                if self.Settings.WatermarkShowTime then table.insert(parts, timeStr) end

                if #parts == 0 then parts = { "Fluent" } end

                wmText.Text = table.concat(parts, "  |  ")
                local txtWidth = wmText.TextBounds.X
                wmFrame.Size   = UDim2.fromOffset(math.max(120, txtWidth + 20), 28)
            end
        end

        -- Keybinds Scanner (Безопасное считывание элементов)
        if self.Settings.KeybindsEnabled and self.Library and self.Library.Options then
            for _, child in ipairs(kbContainer:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end

            local theme = self:GetThemeColors()
            local count = 0

            for name, opt in pairs(self.Library.Options) do
                if type(opt) == "table" and opt.Type == "Keybind" and opt.Value and opt.Value ~= "None" then
                    local isActive = false
                    pcall(function() isActive = opt:GetState() end)

                    if isActive or self.Settings.KeybindsShowInactive or self.EditMode then
                        count = count + 1

                        local row = Instance.new("Frame")
                        row.Size                   = UDim2.new(1, 0, 0, 16)
                        row.BackgroundTransparency = 1
                        row.ZIndex                 = 12
                        row.Parent                 = kbContainer

                        local lblName = Instance.new("TextLabel", row)
                        lblName.Size                   = UDim2.new(0.65, 0, 1, 0)
                        lblName.BackgroundTransparency = 1
                        lblName.Font                   = Enum.Font.Gotham
                        lblName.TextSize               = 11
                        lblName.TextColor3             = theme.Text
                        lblName.TextXAlignment         = Enum.TextXAlignment.Left
                        lblName.Text                   = tostring(name)
                        lblName.ZIndex                 = 12

                        local modeStr = opt.Mode or "Toggle"
                        local valLbl  = Instance.new("TextLabel", row)
                        valLbl.Size                   = UDim2.new(0.35, 0, 1, 0)
                        valLbl.Position               = UDim2.new(0.65, 0, 0, 0)
                        valLbl.BackgroundTransparency = 1
                        valLbl.Font                   = Enum.Font.GothamMedium
                        valLbl.TextSize               = 11
                        valLbl.TextColor3             = isActive and theme.Accent or Color3.fromRGB(130, 130, 130)
                        valLbl.TextXAlignment         = Enum.TextXAlignment.Right
                        valLbl.Text                   = "[" .. tostring(opt.Value) .. "]"
                        valLbl.ZIndex                 = 12
                    end
                end
            end

            kbFrame.Size = UDim2.fromOffset(180, 30 + (count * 18))
        end
    end))

    self:UpdateTheme()
end

