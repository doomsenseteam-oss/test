-- 6. РЕЖИМ РЕДАКТИРОВАНИЯ ЭКРАННЫХ ЭЛЕМЕНТОВ (EDIT DRAG MODE)
-- ═══════════════════════════════════════════════════════════════════════════

function FluentHUD:SetEditMode(state)
    self.EditMode = state
    local theme = self:GetThemeColors()

    local highlightColor = state and Color3.fromRGB(255, 180, 0) or theme.Stroke

    if self.Elements.WatermarkStroke then
        self.Elements.WatermarkStroke.Color     = highlightColor
        self.Elements.WatermarkStroke.Thickness = state and 2 or 1
    end

    if self.Elements.KeybindsStroke then
        self.Elements.KeybindsStroke.Color     = highlightColor
        self.Elements.KeybindsStroke.Thickness = state and 2 or 1
    end

    for _, btn in pairs(self.MobileButtons) do
        if btn.SetDragMode then btn.SetDragMode(state) end
    end
end

