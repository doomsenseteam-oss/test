-- 3. СОХРАНЕНИЕ И ЗАГРУЗКА НАСТРОЕК
-- ═══════════════════════════════════════════════════════════════════════════

function FluentHUD:SetFolder(folder)
    self.Folder = folder
end

function FluentHUD:SetLibrary(library)
    self.Library = library
end

function FluentHUD:SaveSettings()
    if not isfolder(self.Folder) then pcall(makefolder, self.Folder) end
    local cfgPath = self.Folder .. "/hud_v2_settings.json"
    local data = {
        Settings = self.Settings,
        Mobile   = self.MobileSettings
    }
    pcall(function() writefile(cfgPath, HttpService:JSONEncode(data)) end)
end

function FluentHUD:LoadSettings()
    local cfgPath = self.Folder .. "/hud_v2_settings.json"
    if isfile and isfile(cfgPath) then
        local success, decoded = pcall(HttpService.JSONDecode, HttpService, readfile(cfgPath))
        if success and type(decoded) == "table" then
            if decoded.Settings then
                for k, v in pairs(decoded.Settings) do self.Settings[k] = v end
            end
            if decoded.Mobile then
                for k, v in pairs(decoded.Mobile) do self.MobileSettings[k] = v end
            end
        end
    end
end

